# Python
__pycache__/
*.py[cod]
.venv/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
# Backups/copies of a SQLite DB (e.g. db.sqlite3.bak-*) — the bare *.sqlite3 rule
# misses these because the suffix moves the extension, so a 200MB+ prod-DB copy can
# slip into a commit. Match anything after the .sqlite3.
*.sqlite3.*
.ruff_cache/
.pytest_cache/
.ty_cache/

# Node / SvelteKit
node_modules/
frontend/.svelte-kit/
frontend/build/

# Env / OS
.env
.DS_Store

# Playwright MCP (screenshots, traces) + ad-hoc review screenshots at repo root.
# Screenshots are for PR review only — never committed to the repo.
.playwright-mcp/
/*-desktop.png
/*-mobile.png
docs/screenshots/

# Claude Code (local config + sub-worktrees)
.claude/

# Eval suite: throwaway DB (also matched by *.sqlite3) + bulky per-run artefacts.
# The append-only ledger backend/evals/index.jsonl is kept (committable history).
backend/evals/runs/
backend/evals/eval.sqlite3
