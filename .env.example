# Cookmarks environment overrides. Copy to `.env` and fill in. All settings are
# optional — Cookmarks runs with sensible defaults.

# ── Calibre library ──────────────────────────────────────────────────────────
# Absolute path to the host Calibre library (mounted read-only at /library).
# COOKMARKS_CALIBRE_LIBRARY=/path/to/calibre-library

# ── Accounts ─────────────────────────────────────────────────────────────────
# "session" (default) requires a username and password; "none" disables accounts
# entirely and runs everything as a single implicit user. Seed the first admin with
#   docker compose exec cookmarks uv run python -m scripts.create_user <name> --admin
# COOKMARKS_AUTH_MODE=session

# ── Linear "Submit a ticket" ─────────────────────────────────────────────────
# Enables the in-app "Submit a ticket" footer link, which files issues into the
# Cookmarks Linear project. The link stays hidden until LINEAR_API_KEY and
# LINEAR_TEAM_ID are both set. Generate a personal key in Linear → Settings →
# Security & access. The IDs below are the Cookmarks project's.
COOKMARKS_LINEAR_API_KEY=
COOKMARKS_LINEAR_TEAM_ID=83fd199d-1bf0-4890-98a2-48221c04d00d
COOKMARKS_LINEAR_PROJECT_ID=8e5be902-803f-4f93-89a2-6b05ab2fcbd1
